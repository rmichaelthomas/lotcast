import "std:types"
import "std:encoding"
import "std:json"
import "std:text"
import "pkg:lotcast-core/src/lib.gu"
import "pkg:lotcast-log/src/lib.gu"
import "client.gu"
import "plan.gu"

# The work of `draw`, `get` and `verify` as values, with nothing printed: the command line and the
# MCP server both build on these. The network, the clock and the sleep are passed in.

# `verdict` is verified, verified-pending-live, verified-unanchored or invalid.
pub record Check:
    verdict: Text
    detail: Text
    failed_step: Int
    not_checked: List[Int]

# `status` is complete, pending or anchor-failed.
pub record Drawn:
    status: Text
    id: Text
    index: Int
    receipt: Json
    waiting_on: Json
    check: Check

pub fn check_value(receipt: Json, operator_key: Bytes, asked: Bool, question: Text, salt: Bytes, live: Bool) -> Check:
    let verdict = verify_any(receipt, operator_key, tsa_pins(), asked, question, salt)
    if verdict.result == "verified-pending-live" and live:
        let confirmed = live_recheck(receipt)
        if is_ok(confirmed):
            return Check("verified", "Every step passed offline, and the live chains confirm that these sources still have no pulse for this draw: " + text_join(unwrap(confirmed), ", ") + ".", 0, [])
        match confirmed:
            Err(problem):
                if problem.code == "E_LOTCAST_PENDING":
                    return Check("verified-pending-live", problem.message, 0, verdict.not_checked)
                return Check("invalid", problem.message, 4, [])
            Ok(ignored):
                return Check("invalid", "unreadable", 4, [])
    return Check(verdict.result, verdict.detail, verdict.failed_step, verdict.not_checked)

fn none_check() -> Check:
    let none: List[Int] = []
    return Check("", "", 0, none)

fn drawn_from(view: Json, key: Bytes, asked: Bool, question: Text, salt: Bytes) -> Drawn:
    let id = json_as_text(json_get(view, "id"))
    let index = json_as_int(json_get(view, "index"))
    let status = json_as_text(json_get(view, "status"))
    var waiting = json_array()
    let listed = json_get_safe(view, "waiting_on")
    if is_ok(listed) and is_array(unwrap(listed)):
        set waiting = unwrap(listed)
    if status == "complete":
        let receipt = json_get(view, "receipt")
        return Drawn("complete", id, index, receipt, waiting, check_value(receipt, key, asked, question, salt, false))
    if status == "anchor-failed":
        return Drawn("anchor-failed", id, index, json_null(), waiting, none_check())
    return Drawn("pending", id, index, json_null(), waiting, none_check())

# Polls a draw until it is complete, anchor-failed, or `wait` seconds have passed (by the clock, and
# at least by the sleeps taken). An answer that is not a draw view is an error.
fn poll(server: Text, id: Text, wait: Int, send: fn(Text, Text, Text) -> Result[Reply, StdError], pause: fn(Int) -> Unit, now: fn() -> Int) -> Result[Json, Text]:
    let started = now()
    var slept = 0
    var last = json_null()
    while true:
        let reply = send("GET", server + "/v1/draws/" + id, "")
        if is_ok(reply) and unwrap(reply).status == 200:
            if view_is_queued(unwrap(reply).body):
                # Not logged yet: nothing to check, keep waiting.
                set last = unwrap(reply).body
            else:
                let wrong = view_problem(unwrap(reply).body)
                if wrong != "":
                    return Err(wrong)
                set last = unwrap(reply).body
                let status = json_as_text(json_get(last, "status"))
                if status == "complete" or status == "anchor-failed":
                    return Ok(last)
        var waited = slept
        if now() - started > waited:
            set waited = now() - started
        if waited >= wait:
            if json_is_null(last):
                return Err("the service did not answer")
            return Ok(last)
        pause(3)
        set slept = slept + 3
    return Ok(last)

# The draw as the POST left it: logged and promised, nothing known yet.
fn error_text(r: Result[Json, Text]) -> Text:
    match r:
        Err(message):
            return message
        Ok(ignored):
            return ""

fn logged_only(id: Text, index: Int) -> Drawn:
    return Drawn("pending", id, index, json_null(), json_array(), none_check())

pub fn run_draw(plan: DrawPlan, key: Bytes, send: fn(Text, Text, Text) -> Result[Reply, StdError], pause: fn(Int) -> Unit, now: fn() -> Int, logged: fn(Text, Int) -> Unit) -> Result[Drawn, Text]:
    let posted = send("POST", plan.server + "/v1/draws", plan.body)
    if not is_ok(posted):
        match posted:
            Err(problem):
                return Err(problem.message)
            Ok(ignored):
                return Err("no answer")
    let reply = unwrap(posted)
    if reply.status != 200 and reply.status != 202:
        return Err("the service refused the request: " + error_message(reply.body))
    var id = ""
    var index = 0
    var view: Result[Json, Text] = Err("not polled")
    if view_is_queued(reply.body):
        # The writer had not logged the request when the service answered (202). It promises nothing yet,
        # so there is nothing to bind: wait until the draw has a promise, then bind it like any other.
        set id = json_as_text(json_get(reply.body, "id"))
        if len(plan.entry_hash_hex) < 32 or text_slice(plan.entry_hash_hex, 0, 32) != id:
            return Err("the service answered for a different entry than the one sent: do not trust this draw")
        set view = poll(plan.server, id, plan.wait_seconds, send, pause, now)
        if not is_ok(view):
            return Err(error_text(view))
        if view_is_queued(unwrap(view)):
            return Err("the service had not logged the request when the wait ended; the draw is " + id + ", ask for it again with lotcast get")
        let first = binding_problem(unwrap(view), key, plan.request_json, plan.entry_hash_hex, id)
        if first != "":
            return Err(first + ": do not trust this draw")
        set index = json_as_int(json_get(unwrap(view), "index"))
        logged(id, index)
    else:
        let wrong = view_problem(reply.body)
        if wrong != "":
            return Err(wrong)
        set id = json_as_text(json_get(reply.body, "id"))
        let doubt = binding_problem(reply.body, key, plan.request_json, plan.entry_hash_hex, id)
        if doubt != "":
            return Err(doubt + ": do not trust this draw")
        set index = json_as_int(json_get(reply.body, "index"))
        logged(id, index)
        # From here the draw is in the log: whatever goes wrong while waiting, the caller still gets its id.
        set view = poll(plan.server, id, plan.wait_seconds, send, pause, now)
    if not is_ok(view):
        return Ok(logged_only(id, index))
    let later = binding_problem(unwrap(view), key, plan.request_json, plan.entry_hash_hex, id)
    if later != "":
        return Err(later + ": do not trust this draw")
    var salt = bytes_from_ints([])
    if plan.has_question:
        let decoded = hex_decode(plan.salt_hex)
        if not is_ok(decoded):
            return Err("the salt is not hex")
        set salt = unwrap(decoded)
    return Ok(drawn_from(unwrap(view), key, plan.has_question, plan.question, salt))

# `expected_request` and `expected_hash` are what a sealed draw's record holds ("" when not known).
pub fn fetch_draw(server: Text, id: Text, key: Bytes, wait: Int, send: fn(Text, Text, Text) -> Result[Reply, StdError], pause: fn(Int) -> Unit, now: fn() -> Int, expected_request: Text, expected_hash: Text, asked: Bool, question: Text, salt: Bytes) -> Result[Drawn, Text]:
    let view = poll(server, id, wait, send, pause, now)?
    let doubt = binding_problem(view, key, expected_request, expected_hash, id)
    if doubt != "":
        return Err(doubt + ": do not trust this draw")
    return Ok(drawn_from(view, key, asked, question, salt))
