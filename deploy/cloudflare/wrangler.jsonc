{
  "name": "lotcast",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "vars": { "PUBLIC_URL": "https://lotcast.thomasbuild.workers.dev" },
  "assets": { "directory": "../../verify-web/public", "binding": "ASSETS" },
  "containers": [
    {
      "class_name": "Lotcast",
      "image": "../../service/Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": { "bindings": [{ "class_name": "Lotcast", "name": "LOTCAST" }] },
  "migrations": [{ "new_sqlite_classes": ["Lotcast"], "tag": "v1" }]
}
