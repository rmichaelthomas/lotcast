import "std:types"
import "std:encoding"
import "std:text"

# Byte encoders for the Lotcast wire formats: fixed-width big-endian integers and the
# length-prefixed `lp` convention (a 4-byte big-endian length, then the bytes).

# The `width` big-endian bytes of `x`. Uses `//` and `%` so values at or above 2^63 work (the bit
# operations are signed 64-bit).
fn be_bytes(x: Int, width: Int) -> Bytes:
    assert(x >= 0)
    var octets: List[Int] = []
    var place = 1
    var count = 1
    while count < width:
        set place = place * 256
        set count = count + 1
    assert(x // place < 256)
    var rest = x
    while place >= 1:
        set octets = list_push(octets, rest // place)
        set rest = rest % place
        set place = place // 256
    return bytes_from_ints(octets)

pub fn u8_bytes(x: Int) -> Bytes:
    return be_bytes(x, 1)

pub fn u32_bytes(x: Int) -> Bytes:
    return be_bytes(x, 4)

pub fn u64_bytes(x: Int) -> Bytes:
    return be_bytes(x, 8)

pub fn lp(b: Bytes) -> Bytes:
    return bytes_join([u32_bytes(len(b)), b])

pub fn cat(parts: List[Bytes]) -> Bytes:
    return bytes_join(parts)

# Big-endian unsigned value of any number of bytes.
pub fn bytes_to_int(b: Bytes) -> Int:
    let octets = bytes_to_ints(b)
    var value = 0
    for octet in octets:
        set value = value * 256 + octet
    return value

pub fn text_bytes(t: Text) -> Bytes:
    return bytes_from_text(t)
