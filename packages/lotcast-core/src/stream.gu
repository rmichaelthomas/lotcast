import "std:types"
import "std:crypto"
import "std:encoding"
import "encode.gu"

# The Lotcast stream (spec §4.3): block(i) = SHA-512("lotcast/stream/v1" ‖ seed ‖ u64(i)), read as
# words. At width 64 each block is eight big-endian u64 words; at width 8 (the exact-enumeration
# tests) each block is its 64 bytes, one word per byte; widths 16 and 32 split it the same way.
#
# A Stream is a value: every draw returns the next Stream. Three modes share the record:
#   0 hash      the production stream
#   1 tape      serves primitive results from a list and records each call's modulus (enumeration)
#   2 scripted  serves given words in order, then zeros (word-level enumeration of uniform)
pub record Stream:
    seed: Bytes
    word_bits: Int
    block: Int
    words: List[Int]
    pos: Int
    mode: Int
    tape: List[Int]
    tape_pos: Int
    trace: List[Int]

pub record Word:
    value: Int
    stream: Stream

pub fn stream_new(seed: Bytes, word_bits: Int) -> Stream:
    assert(word_bits == 8 or word_bits == 16 or word_bits == 32 or word_bits == 64)
    return Stream(seed, word_bits, 0, [], 0, 0, [], 0, [])

# Test-only: a stream that serves `words` (each below 2^word_bits) in order, then zeros.
pub fn stream_scripted(words: List[Int], word_bits: Int) -> Stream:
    return Stream(bytes_from_ints([]), word_bits, 0, words, 0, 2, [], 0, [])

# Test-only: a stream whose primitive calls (uniform, weighted, shuffle) return `choices` in order,
# then 0. `stream_trace` lists the modulus of every primitive call made.
pub fn stream_tape(choices: List[Int]) -> Stream:
    return Stream(bytes_from_ints([]), 64, 0, [], 0, 1, choices, 0, [])

pub fn stream_trace(s: Stream) -> List[Int]:
    return s.trace

fn block_words(seed: Bytes, word_bits: Int, index: Int) -> List[Int]:
    let block = crypto_sha512(cat([text_bytes("lotcast/stream/v1"), seed, u64_bytes(index)]))
    let size = word_bits // 8
    let octets = bytes_to_ints(block)
    var out: List[Int] = []
    var at = 0
    while at < 64:
        var value = 0
        var k = 0
        while k < size:
            set value = value * 256 + octets[at + k]
            set k = k + 1
        set out = list_push(out, value)
        set at = at + size
    return out

# The next word. Modes 0 and 2 only; the primitives handle mode 1 themselves.
pub fn next_word(s: Stream) -> Word:
    if s.mode == 2:
        var value = 0
        if s.pos < len(s.words):
            set value = s.words[s.pos]
        return Word(value, Stream(s.seed, s.word_bits, s.block, s.words, s.pos + 1, 2, [], 0, []))
    assert(s.mode == 0)
    if s.pos >= len(s.words):
        let fresh = block_words(s.seed, s.word_bits, s.block)
        return Word(fresh[0], Stream(s.seed, s.word_bits, s.block + 1, fresh, 1, 0, [], 0, []))
    return Word(s.words[s.pos], Stream(s.seed, s.word_bits, s.block, s.words, s.pos + 1, 0, [], 0, []))
