import "std:types"
import "std:encoding"
import "std:json"
import "std:text"
import "pkg:lotcast-log/src/lib.gu"
import "src/lib.gu"

# Re-checks a receipt offline: reads the file, recomputes the entry, the log inclusion, the
# timestamps, the seed and the outcome, and checks every beacon pulse it carries.
#
#   guion run verify_receipt.gu RECEIPT.json [--operator-key HEX] [--question TEXT --salt HEX]
#
# A receipt with a log needs the operator's public key (draw.gu prints it as operator_key=HEX). A
# receipt with no log is checked as before and is at best verified-unanchored.
#
# Prints the result on the first line: verified, verified-pending-live, verified-unanchored or
# invalid. For invalid it names the failing step (1 entry and promise, 2 checkpoint and inclusion,
# 3 timestamps, 4 sources, 5 outcome, 6 question) and why; otherwise it says what the result covers.
# Exit 0 when verified in any of the three ways, 1 when invalid, 2 when the input cannot be read.

fn usage() -> Int:
    eprint("usage: verify_receipt.gu RECEIPT.json [--operator-key HEX] [--question TEXT --salt HEX]")
    return 2

fn main() -> Int:
    let all = args()
    if len(all) < 1:
        return usage()
    var operator_key = bytes_from_ints([])
    var question = ""
    var salt = bytes_from_ints([])
    var asked = false
    var have_salt = false
    var i = 1
    while i < len(all):
        if i + 1 >= len(all):
            return usage()
        if all[i] == "--operator-key":
            let decoded = hex_decode(all[i + 1])
            if not is_ok(decoded) or len(unwrap(decoded)) != 32:
                eprint("the operator key must be 32 bytes of hex")
                return 2
            set operator_key = unwrap(decoded)
        else:
            if all[i] == "--question":
                set question = all[i + 1]
                set asked = true
            else:
                if all[i] == "--salt":
                    let decoded = hex_decode(all[i + 1])
                    if not is_ok(decoded):
                        eprint("the salt is not hex")
                        return 2
                    set salt = unwrap(decoded)
                    set have_salt = true
                else:
                    return usage()
        set i = i + 2
    if asked != have_salt:
        return usage()
    let body = read_text(all[0])
    if not is_ok(body):
        eprint("cannot read " + all[0])
        return 2
    let parsed = json_parse(unwrap(body))
    if not is_ok(parsed):
        eprint(all[0] + " is not JSON")
        return 2
    let log = json_get_safe(unwrap(parsed), "log")
    if is_ok(log) and not json_is_null(unwrap(log)) and len(operator_key) == 0:
        eprint("this receipt has a log: pass the operator's public key with --operator-key HEX")
        return 2
    let verdict = verify_any(unwrap(parsed), operator_key, tsa_pins(), asked, question, salt)
    print(verdict.result)
    if verdict.result == "invalid":
        print("failed step " + int_to_text(verdict.failed_step) + ": " + verdict.detail)
        return 1
    print(verdict.detail)
    return 0
