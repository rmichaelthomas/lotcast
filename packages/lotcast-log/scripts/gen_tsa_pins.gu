import "std:types"
import "std:json"
import "std:text"
import "std:process"

# Generates src/tsa_pins.gu (pinned issuer certificates) and fixtures/tsa/tokens.json from the
# chains and tokens that fetch_tsa_fixtures.sh saved.
#
#   cd packages/lotcast-log
#   guion run --file-root . scripts/gen_tsa_pins.gu

fn fail(message: Text) -> Int:
    eprint(message)
    return 1

# The base64 bodies of every certificate in a PEM file, with all whitespace removed.
fn pem_blocks(text: Text) -> List[Text]:
    var out: List[Text] = []
    var at = 0
    let begin = "-----BEGIN CERTIFICATE-----"
    let end = "-----END CERTIFICATE-----"
    while true:
        let a = text_find(text, begin, at)
        if a < 0:
            return out
        let b = text_find(text, end, a)
        if b < 0:
            return out
        let body = text_slice(text, a + len(begin), b)
        set out = list_push(out, strip_space(body))
        set at = b + len(end)
    return out

fn strip_space(text: Text) -> Text:
    var out = ""
    for i in range(0, len(text)):
        let c = text_slice(text, i, i + 1)
        if c != " " and c != "\n" and c != "\r" and c != "\t":
            set out = out + c
    return out

fn read_all(path: Text) -> Result[Text, Text]:
    let got = read_text(path)
    if not is_ok(got):
        return Err("cannot read " + path)
    return Ok(unwrap(got))

fn pin_lines(name: Text, host: Text, url: Text, issuer: Text) -> Text:
    return "pub fn tsa_issuer_" + name + "() -> Text:\n    return \"" + issuer + "\"\n\n" + "pub fn tsa_host_" + name + "() -> Text:\n    return \"" + host + "\"\n\n" + "pub fn tsa_url_" + name + "() -> Text:\n    return \"" + url + "\"\n\n"

fn main() -> Int:
    let names = ["digicert", "sectigo", "freetsa"]
    let hosts = ["timestamp.digicert.com", "timestamp.sectigo.com", "freetsa.org"]
    let urls = ["http://timestamp.digicert.com", "http://timestamp.sectigo.com", "https://freetsa.org/tsr"]
    var out = "# Generated by scripts/gen_tsa_pins.gu from fixtures/tsa. Do not edit by hand.\n# Each pin is the base64 DER of the certificate that issued the TSA's signing certificate. A token\n# carries its own signing certificate (they rotate yearly); it is accepted only when a pinned issuer\n# issued it.\n\n"
    let digest_text = read_all("fixtures/tsa/digest.hex")
    if not is_ok(digest_text):
        return fail("cannot read fixtures/tsa/digest.hex")
    var tokens = json_object()
    for i in range(0, len(names)):
        let name = names[i]
        let chain = read_all("fixtures/tsa/" + name + ".chain.pem")
        let token = read_all("fixtures/tsa/" + name + ".token.b64")
        if not is_ok(chain) or not is_ok(token):
            return fail("missing fixtures for " + name)
        let blocks = pem_blocks(unwrap(chain))
        if len(blocks) < 2:
            return fail(name + ": the chain has no issuer certificate")
        set out = out + pin_lines(name, hosts[i], urls[i], blocks[1])
        set tokens = json_set(tokens, name, json_text(strip_space(unwrap(token))))
    var document = json_object()
    set document = json_set(document, "digest", json_text(strip_space(unwrap(digest_text))))
    set document = json_set(document, "tokens", tokens)
    # The Python script ended the file without a trailing newline after the last blank line; keep one.
    if not is_ok(write_text_atomic("src/tsa_pins.gu", text_slice(out, 0, len(out) - 1))):
        return fail("cannot write src/tsa_pins.gu")
    if not is_ok(write_text_atomic("fixtures/tsa/tokens.json", json_stringify(document))):
        return fail("cannot write fixtures/tsa/tokens.json")
    print("wrote src/tsa_pins.gu and fixtures/tsa/tokens.json")
    return 0
