import "std:types"
import "std:crypto"
import "std:encoding"
import "std:text"
import "std:json"
import "std:fs"
import "src/lib.gu"
import "src/encode.gu"

fn main() -> Int:
    return 0

fn hexb(t: Text) -> Bytes:
    return unwrap(hex_decode(t))

fn vectors() -> Json:
    return unwrap(json_parse(unwrap(read_text("fixtures/merkle-vectors.json"))))

fn hex_list(j: Json) -> List[Bytes]:
    var out: List[Bytes] = []
    var i = 0
    while i < json_len(j):
        set out = list_push(out, hexb(json_as_text(unwrap(json_index_safe(j, i)))))
        set i = i + 1
    return out

fn first_leaves(v: Json, n: Int) -> List[Bytes]:
    let all = hex_list(json_get(v, "leaves"))
    var out: List[Bytes] = []
    var i = 0
    while i < n:
        set out = list_push(out, all[i])
        set i = i + 1
    return out

fn test_root_matches_vectors() -> Unit:
    let v = vectors()
    let roots = json_get(v, "roots")
    var n = 0
    while n < json_len(roots):
        let expected = hexb(json_as_text(unwrap(json_index_safe(roots, n))))
        assert(tree_root(first_leaves(v, n)) == expected)
        set n = n + 1

fn test_ct_reference_tree_root() -> Unit:
    let v = vectors()
    assert(tree_root(hex_list(json_get(v, "ct_leaves"))) == hexb(json_as_text(json_get(v, "ct_root_8"))))

fn test_inclusion_proofs_match_vectors() -> Unit:
    let v = vectors()
    let cases = json_get(v, "inclusion")
    var i = 0
    while i < json_len(cases):
        let c = unwrap(json_index_safe(cases, i))
        let size = json_as_int(json_get(c, "size"))
        let index = json_as_int(json_get(c, "index"))
        let leaves = first_leaves(v, size)
        let proof = unwrap(inclusion_proof(leaves, index))
        assert(proof == hex_list(json_get(c, "proof")))
        assert(verify_inclusion(leaves[index], index, size, proof, tree_root(leaves)))
        set i = i + 1

fn test_inclusion_rejects_wrong_leaf_index_size_and_root() -> Unit:
    let v = vectors()
    let leaves = first_leaves(v, 11)
    let root = tree_root(leaves)
    let proof = unwrap(inclusion_proof(leaves, 6))
    assert(verify_inclusion(leaves[6], 6, 11, proof, root))
    assert(not verify_inclusion(leaves[5], 6, 11, proof, root))
    assert(not verify_inclusion(leaves[6], 7, 11, proof, root))
    assert(not verify_inclusion(leaves[6], 6, 20, proof, root))
    assert(not verify_inclusion(leaves[6], 6, 11, proof, tree_root(first_leaves(v, 10))))
    assert(not verify_inclusion(leaves[6], 11, 11, proof, root))
    assert(not verify_inclusion(leaves[6], 6, 11, [], root))

fn test_consistency_proofs_match_vectors() -> Unit:
    let v = vectors()
    let cases = json_get(v, "consistency")
    var i = 0
    while i < json_len(cases):
        let c = unwrap(json_index_safe(cases, i))
        let old = json_as_int(json_get(c, "old"))
        let new = json_as_int(json_get(c, "new"))
        let leaves = first_leaves(v, new)
        let proof = unwrap(consistency_proof(leaves, old))
        assert(proof == hex_list(json_get(c, "proof")))
        assert(verify_consistency(old, tree_root(first_leaves(v, old)), new, tree_root(leaves), proof))
        set i = i + 1

fn test_consistency_rejects_tampered_proof() -> Unit:
    let v = vectors()
    let leaves = first_leaves(v, 13)
    let old_root = tree_root(first_leaves(v, 5))
    let new_root = tree_root(leaves)
    let proof = unwrap(consistency_proof(leaves, 5))
    assert(verify_consistency(5, old_root, 13, new_root, proof))
    assert(not verify_consistency(5, old_root, 13, new_root, []))
    assert(not verify_consistency(5, new_root, 13, new_root, proof))
    assert(not verify_consistency(6, old_root, 13, new_root, proof))
    assert(not verify_consistency(5, old_root, 13, old_root, proof))
    var flipped: List[Bytes] = []
    var i = 0
    for p in proof:
        if i == 0:
            set flipped = list_push(flipped, crypto_sha256(p))
        else:
            set flipped = list_push(flipped, p)
        set i = i + 1
    assert(not verify_consistency(5, old_root, 13, new_root, flipped))

fn test_size_zero_and_one_edges() -> Unit:
    let v = vectors()
    let empty: List[Bytes] = []
    assert(tree_root(empty) == crypto_sha256(bytes_from_ints([])))
    assert(not is_ok(inclusion_proof(empty, 0)))
    let one = first_leaves(v, 1)
    assert(verify_inclusion(one[0], 0, 1, [], tree_root(one)))
    assert(verify_consistency(0, tree_root(empty), 1, tree_root(one), []))
    assert(verify_consistency(1, tree_root(one), 1, tree_root(one), []))
    assert(not verify_consistency(2, tree_root(one), 1, tree_root(one), []))
    assert(not is_ok(consistency_proof(one, 2)))

# The signed text, or "<none>" when that signer is absent or wrong.
fn signed_text(r: Result[Option[Text], StdError]) -> Text:
    match unwrap(r):
        Some(t):
            return t
        None:
            return "<none>"

fn note_vectors() -> Json:
    return unwrap(json_parse(unwrap(read_text("fixtures/note-vectors.json"))))

fn vtext(v: Json, key: Text) -> Text:
    return json_as_text(json_get(v, key))

fn op_name(v: Json) -> Text:
    return json_as_text(json_get(json_get(v, "operator"), "name"))

fn op_seed(v: Json) -> Bytes:
    return hexb(json_as_text(json_get(json_get(v, "operator"), "seed")))

fn op_public(v: Json) -> Bytes:
    return hexb(json_as_text(json_get(json_get(v, "operator"), "public")))

fn w_name(v: Json) -> Text:
    return json_as_text(json_get(json_get(v, "witness"), "name"))

fn w_seed(v: Json) -> Bytes:
    return hexb(json_as_text(json_get(json_get(v, "witness"), "seed")))

fn w_public(v: Json) -> Bytes:
    return hexb(json_as_text(json_get(json_get(v, "witness"), "public")))

fn test_note_matches_python_vector() -> Unit:
    let v = note_vectors()
    let signed = unwrap(sign_note(vtext(v, "checkpoint_text"), op_name(v), op_seed(v)))
    assert(signed == vtext(v, "note_operator"))
    assert(key_hash(op_name(v), op_public(v)) == hexb(json_as_text(json_get(json_get(v, "operator"), "key_hash"))))
    let both = unwrap(add_signature(signed, w_name(v), w_seed(v)))
    assert(both == vtext(v, "note_both"))

fn test_verify_accepts_only_the_named_key() -> Unit:
    let v = note_vectors()
    let note = vtext(v, "note_operator")
    assert(signed_text(verify_note(note, op_name(v), op_public(v))) == vtext(v, "checkpoint_text"))
    assert(signed_text(verify_note(note, op_name(v), w_public(v))) == "<none>")
    assert(signed_text(verify_note(note, w_name(v), w_public(v))) == "<none>")

fn test_second_signature_does_not_invalidate_first() -> Unit:
    let v = note_vectors()
    let note = vtext(v, "note_both")
    assert(signed_text(verify_note(note, op_name(v), op_public(v))) == vtext(v, "checkpoint_text"))
    assert(signed_text(verify_note(note, w_name(v), w_public(v))) == vtext(v, "checkpoint_text"))

fn test_tampered_text_fails() -> Unit:
    let v = note_vectors()
    let note = vtext(v, "note_operator")
    let tampered = text_replace(note, "12345", "12346")
    assert(tampered != note)
    assert(signed_text(verify_note(tampered, op_name(v), op_public(v))) == "<none>")

fn test_unknown_key_hash_is_ignored_not_error() -> Unit:
    let v = note_vectors()
    let line = vtext(v, "signature_line_witness")
    let renamed = text_replace(line, w_name(v), op_name(v))
    let note = vtext(v, "note_operator") + renamed
    assert(signed_text(verify_note(note, op_name(v), op_public(v))) == vtext(v, "checkpoint_text"))
    assert(signed_text(verify_note(vtext(v, "note_both"), "someone.else/log", op_public(v))) == "<none>")

fn test_malformed_notes_are_errors() -> Unit:
    let v = note_vectors()
    let text = vtext(v, "checkpoint_text")
    assert(not is_ok(verify_note(text, op_name(v), op_public(v))))
    assert(not is_ok(verify_note(text + "\n", op_name(v), op_public(v))))
    assert(not is_ok(sign_note("no trailing newline", op_name(v), op_seed(v))))
    let bad = text + "\n— " + op_name(v) + " !!!notbase64\n"
    assert(not is_ok(verify_note(bad, op_name(v), op_public(v))))

fn test_checkpoint_round_trip() -> Unit:
    let v = note_vectors()
    let parsed = unwrap(parse_checkpoint(vtext(v, "checkpoint_text")))
    assert(parsed.origin == op_name(v))
    assert(parsed.size == 12345)
    assert(parsed.root == hexb(vtext(v, "root")))
    assert(len(parsed.extensions) == 0)
    assert(checkpoint_text(parsed) == vtext(v, "checkpoint_text"))
    let ext = unwrap(parse_checkpoint(vtext(v, "checkpoint_text_extension")))
    assert(ext.size == 7)
    assert(ext.extensions == ["extra line"])
    assert(checkpoint_text(ext) == vtext(v, "checkpoint_text_extension"))

fn test_checkpoint_rejects_bad_size_and_bad_root_length() -> Unit:
    let root = base64_encode(crypto_sha256(bytes_from_ints([1])))
    assert(is_ok(parse_checkpoint("o\n0\n" + root + "\n")))
    assert(not is_ok(parse_checkpoint("o\n01\n" + root + "\n")))
    assert(not is_ok(parse_checkpoint("o\n-1\n" + root + "\n")))
    assert(not is_ok(parse_checkpoint("o\n1x\n" + root + "\n")))
    assert(not is_ok(parse_checkpoint("o\n1\n" + base64_encode(bytes_from_ints([1, 2, 3])) + "\n")))
    assert(not is_ok(parse_checkpoint("o\n1\n" + root)))
    assert(not is_ok(parse_checkpoint("\n1\n" + root + "\n")))

fn tile_vectors() -> Json:
    return unwrap(json_parse(unwrap(read_text("fixtures/tiles-vectors.json"))))

fn test_tile_paths_match_c2sp_examples() -> Unit:
    let v = tile_vectors()
    let cases = json_get(v, "paths")
    var i = 0
    while i < json_len(cases):
        let c = unwrap(json_index_safe(cases, i))
        let level = json_as_int(json_get(c, "level"))
        let index = json_as_int(json_get(c, "index"))
        let width = json_as_int(json_get(c, "width"))
        var got = ""
        if level < 0:
            set got = entry_bundle_path(index, width)
        else:
            set got = tile_path(level, index, width)
        assert(got == json_as_text(json_get(c, "path")))
        set i = i + 1
    assert(tile_path(0, 1234067, 0) == "tile/0/x001/x234/067")
    assert(x_path(0) == "000")
    assert(x_path(999) == "999")
    assert(x_path(1000) == "x001/000")

fn test_bundle_round_trip_and_truncation() -> Unit:
    let entries = [bytes_from_ints([1, 2, 3]), bytes_from_ints([]), bytes_from_ints([9])]
    let blob = unwrap(bundle_bytes(entries, 0, 3))
    assert(blob == bytes_from_ints([0, 3, 1, 2, 3, 0, 0, 0, 1, 9]))
    assert(unwrap(parse_bundle(blob)) == entries)
    assert(not is_ok(parse_bundle(bytes_from_ints([0, 3, 1, 2]))))
    assert(not is_ok(parse_bundle(bytes_from_ints([0]))))
    assert(not is_ok(split_hashes(bytes_from_ints([1, 2, 3]))))

fn test_level_hashes_fold_full_groups_only() -> Unit:
    var hashes: List[Bytes] = []
    var i = 0
    while i < 513:
        set hashes = list_push(hashes, crypto_sha256(u32_bytes(i)))
        set i = i + 1
    assert(len(level_hashes(hashes, 0)) == 513)
    assert(len(level_hashes(hashes, 1)) == 2)
    assert(len(level_hashes(hashes, 2)) == 0)
    var first256: List[Bytes] = []
    var k = 0
    while k < 256:
        set first256 = list_push(first256, hashes[k])
        set k = k + 1
    assert(level_hashes(hashes, 1)[0] == root_of_hashes(first256))

fn op_key_seed() -> Bytes:
    return hexb("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")

fn op_key_public() -> Bytes:
    return unwrap(crypto_ed25519_public_key(op_key_seed()))

fn log_origin() -> Text:
    return "lotcast.example/log"

fn fresh_dir() -> Text:
    return unwrap(fs_temp_dir("lotcast-log-test"))

fn make_entries(n: Int) -> List[Bytes]:
    var out: List[Bytes] = []
    var i = 0
    while i < n:
        set out = list_push(out, text_bytes("entry-" + int_to_text(i)))
        set i = i + 1
    return out

fn open_fresh(dir: Text) -> LogState:
    return unwrap(log_open(dir, log_origin(), log_origin(), op_key_public()))

fn built(n: Int) -> LogState:
    let dir = fresh_dir()
    let appended = unwrap(log_append_many(open_fresh(dir), make_entries(n), log_origin(), op_key_seed(), []))
    return appended.state

fn file_hash_hex(dir: Text, relative: Text) -> Text:
    return hex_encode(crypto_sha256(unwrap(get_file(dir, relative))))

fn test_log_root_and_files_match_python_at_each_size() -> Unit:
    let v = tile_vectors()
    let logs = json_get(v, "logs")
    var i = 0
    while i < json_len(logs):
        let c = unwrap(json_index_safe(logs, i))
        let size = json_as_int(json_get(c, "size"))
        let state = built(size)
        assert(state.size == size)
        assert(log_root(state) == hexb(json_as_text(json_get(c, "root"))))
        let files = json_get(c, "files")
        var f = 0
        while f < json_len(files):
            let file = unwrap(json_index_safe(files, f))
            assert(file_hash_hex(state.dir, json_as_text(json_get(file, "path"))) == json_as_text(json_get(file, "sha256")))
            set f = f + 1
        set i = i + 1

fn test_inclusion_from_log_verifies() -> Unit:
    let state = built(300)
    let root = log_root(state)
    for index in [0, 1, 255, 256, 299]:
        let proof = unwrap(log_inclusion(state, index))
        assert(verify_inclusion(state.entries[index], index, 300, proof, root))
    assert(not is_ok(log_inclusion(state, 300)))

fn test_reopen_after_append_gives_same_checkpoint() -> Unit:
    let state = built(10)
    let reopened = open_fresh(state.dir)
    assert(reopened.size == 10)
    assert(log_checkpoint(reopened) == log_checkpoint(state))
    let more = unwrap(log_append_many(reopened, make_entries(30), log_origin(), op_key_seed(), []))
    assert(more.state.size == 30)
    assert(more.indexes[5] == 5)
    assert(more.indexes[29] == 29)
    let again = open_fresh(state.dir)
    assert(again.size == 30)
    assert(log_root(again) == log_root(more.state))
    let consistency = unwrap(log_consistency(again, 10))
    assert(verify_consistency(10, log_root(reopened), 30, log_root(again), consistency))

fn test_duplicate_entry_returns_existing_index() -> Unit:
    let state = built(5)
    let again = unwrap(log_append(state, text_bytes("entry-3"), log_origin(), op_key_seed(), []))
    assert(again.indexes == [3])
    assert(again.state.size == 5)
    assert(log_checkpoint(again.state) == log_checkpoint(state))
    let mixed = unwrap(log_append_many(state, [text_bytes("entry-1"), text_bytes("brand-new"), text_bytes("brand-new")], log_origin(), op_key_seed(), []))
    assert(mixed.indexes == [1, 5, 5])
    assert(mixed.state.size == 6)

fn test_corrupt_tile_fails_open() -> Unit:
    let state = built(20)
    let victim = state.dir + "/" + tile_path(0, 0, 20)
    assert(is_ok(write_bytes(victim, crypto_sha256(bytes_from_ints([7])))))
    assert(not is_ok(log_open(state.dir, log_origin(), log_origin(), op_key_public())))

fn test_truncated_log_fails_open() -> Unit:
    let state = built(20)
    assert(is_ok(fs_remove(state.dir + "/" + entry_bundle_path(0, 20))))
    assert(not is_ok(log_open(state.dir, log_origin(), log_origin(), op_key_public())))

fn test_checkpoint_from_other_key_or_origin_fails_open() -> Unit:
    let state = built(3)
    assert(not is_ok(log_open(state.dir, "other.example/log", log_origin(), op_key_public())))
    let wrong_public = unwrap(crypto_ed25519_public_key(hexb("ff02030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")))
    assert(not is_ok(log_open(state.dir, log_origin(), log_origin(), wrong_public)))

fn tsa_fixtures() -> Json:
    return unwrap(json_parse(unwrap(read_text("fixtures/tsa/tokens.json"))))

fn fixture_digest() -> Bytes:
    return hexb(json_as_text(json_get(tsa_fixtures(), "digest")))

fn fixture_token(id: Text) -> Bytes:
    return unwrap(base64_decode(json_as_text(json_get(json_get(tsa_fixtures(), "tokens"), id))))

fn test_each_pinned_token_verifies() -> Unit:
    for id in ["digicert", "sectigo", "freetsa"]:
        let content = unwrap(tsa_check(unwrap(pin_by_id(id)), fixture_token(id), fixture_digest()))
        assert(content.gen_time_ms > 1700000000000)
        assert(content.accuracy_ms >= 0)

fn test_token_for_other_digest_fails() -> Unit:
    let other = crypto_sha512(text_bytes("another digest"))
    assert(not is_ok(tsa_check(unwrap(pin_by_id("digicert")), fixture_token("digicert"), other)))

fn test_token_with_other_pin_fails() -> Unit:
    assert(not is_ok(tsa_check(unwrap(pin_by_id("sectigo")), fixture_token("digicert"), fixture_digest())))
    assert(not is_ok(tsa_check(unwrap(pin_by_id("digicert")), fixture_token("freetsa"), fixture_digest())))
    assert(not is_ok(pin_by_id("nobody")))

fn test_proven_by_is_max_of_gen_time_plus_accuracy_plus_one_second_rounded_up() -> Unit:
    let a = TsaToken(1000500, 400, bytes_from_ints([1]), "1.2.3", bytes_from_ints([]))
    let b = TsaToken(999000, 0, bytes_from_ints([2]), "1.2.3", bytes_from_ints([]))
    assert(proven_by_seconds([a, b]) == 1002)
    assert(proven_by_seconds([b, a]) == 1002)
    assert(proven_by_seconds([b]) == 1000)
    let exact = TsaToken(5000, 0, bytes_from_ints([3]), "1.2.3", bytes_from_ints([]))
    assert(proven_by_seconds([exact]) == 6)

fn test_choose_tsas_defaults_and_fallback_after_600_seconds() -> Unit:
    let none: Map[Text, Int] = {}
    assert(choose_tsas(none) == ["digicert", "sectigo"])
    assert(choose_tsas({"digicert": 600}) == ["digicert", "sectigo"])
    assert(choose_tsas({"digicert": 601}) == ["sectigo", "freetsa"])
    assert(choose_tsas({"sectigo": 9999, "digicert": 5}) == ["digicert", "freetsa"])
    assert(len(choose_tsas({"sectigo": 9999, "digicert": 9999})) == 0)


fn test_epoch_line_round_trips_and_is_strict() -> Unit:
    let ext = epoch_extension(12, 1795503700)
    assert(ext == "lotcast/epoch 12 1795503700")
    let info = unwrap(parse_epoch([ext]))
    assert(info.epoch == 12 and info.deadline == 1795503700)
    assert(not is_ok(parse_epoch([])))
    assert(not is_ok(parse_epoch([ext, ext])))
    for bad in ["lotcast/epoch 1abc 5", "lotcast/epoch 01 5", "lotcast/epoch 1 -5", "lotcast/epoch 1", "lotcast/epoch 1 5 6", "lotcast/epoch  1 5"]:
        assert(not is_ok(parse_epoch([bad])))
    let cp = unwrap(parse_checkpoint(checkpoint_text(Checkpoint("o", 3, crypto_sha256(bytes_from_ints([1])), [ext]))))
    assert(unwrap(parse_epoch(cp.extensions)).epoch == 12)

fn test_deleted_checkpoint_does_not_restart_the_log() -> Unit:
    let state = built(3)
    assert(is_ok(fs_remove(state.dir + "/checkpoint")))
    assert(not is_ok(log_open(state.dir, log_origin(), log_origin(), op_key_public())))

fn test_a_second_writer_on_an_old_state_is_refused() -> Unit:
    let state = built(3)
    let first = unwrap(log_append(state, text_bytes("from-writer-one"), log_origin(), op_key_seed(), []))
    assert(first.state.size == 4)
    assert(not is_ok(log_append(state, text_bytes("from-writer-two"), log_origin(), op_key_seed(), [])))
    let reopened = open_fresh(state.dir)
    assert(reopened.size == 4)

fn test_log_lock_is_exclusive_and_released() -> Unit:
    let dir = fresh_dir()
    assert(unwrap(log_lock(dir)))
    assert(not is_ok(log_lock(dir)))
    assert(log_unlock(dir))
    assert(unwrap(log_lock(dir)))
    assert(log_unlock(dir))

fn test_checkpoint_extensions_are_signed_into_the_note() -> Unit:
    let dir = fresh_dir()
    let ext = epoch_extension(1, 1795503700)
    let appended = unwrap(log_append(open_fresh(dir), text_bytes("e"), log_origin(), op_key_seed(), [ext]))
    let text = signed_text(verify_note(log_checkpoint(appended.state), log_origin(), op_key_public()))
    assert(unwrap(parse_epoch(unwrap(parse_checkpoint(text)).extensions)).deadline == 1795503700)
    assert(appended.added == 1)
    let reopened = open_fresh(dir)
    assert(log_checkpoint(reopened) == log_checkpoint(appended.state))

fn test_parse_digits_reads_plain_numbers_without_the_host() -> Unit:
    assert(unwrap(parse_digits("0")) == 0)
    assert(unwrap(parse_digits("42")) == 42)
    assert(unwrap(parse_digits("1795579310")) == 1795579310)
    assert(unwrap(parse_digits("999999999999999999")) == 999999999999999999)
    assert(not is_ok(parse_digits("")))
    assert(not is_ok(parse_digits("1x")))
    assert(not is_ok(parse_digits("-1")))
    assert(not is_ok(parse_digits("1000000000000000000")))

fn test_a_checkpoint_or_epoch_number_too_large_to_hold_is_refused_not_a_crash() -> Unit:
    let root = base64_encode(crypto_sha256(bytes_from_ints([1])))
    assert(not is_ok(parse_checkpoint("o\n99999999999999999999\n" + root + "\n")))
    assert(not is_ok(parse_epoch(["lotcast/epoch 99999999999999999999 5"])))
    assert(is_ok(parse_epoch(["lotcast/epoch 7 5"])))
