import "std:types"
import "std:crypto"
import "std:encoding"
import "std:fs"
import "std:json"
import "std:text"
import "store.gu"
import "pkg:lotcast-log/src/lib.gu"

# Per-client rate limiting for POST /v1/draws: at most `limit` requests in any 60 seconds.
#
# Guion does not tell a server the peer address of a connection (a Guion gap), so the client is
# named only by the proxy in front of the service: with `trust_proxy = N` the client is the Nth
# entry from the right of X-Forwarded-For (the one the Nth proxy added; everything left of it is
# whatever the client claimed and is ignored). With `trust_proxy = 0` there is no client name and
# every request shares one bucket, so the limit still holds, for everyone together.

pub fn rate_window_seconds() -> Int:
    return 60

pub record RateResult:
    allowed: Bool
    kept: List[Int]

# The stamps still inside the window, and whether one more request fits.
pub fn rate_check(stamps: List[Int], now: Int, limit: Int) -> RateResult:
    var kept: List[Int] = []
    for s in stamps:
        if s > now - rate_window_seconds() and s <= now:
            set kept = list_push(kept, s)
    if len(kept) >= limit:
        return RateResult(false, kept)
    return RateResult(true, list_push(kept, now))

pub fn client_key(forwarded: Text, trust_proxy: Int) -> Text:
    if trust_proxy <= 0:
        return "shared"
    var parts: List[Text] = []
    for p in text_split(forwarded, ","):
        let t = text_trim(p)
        if t != "":
            set parts = list_push(parts, t)
    if len(parts) < trust_proxy:
        return "unknown"
    return parts[len(parts) - trust_proxy]

# The per-installation secret that keys the bucket names, so a bucket file cannot be reversed to an
# IP address by hashing every address. Made on first use.
fn rate_salt(store: Store) -> Text:
    if store_has(store, "state/rate_salt"):
        let read = vfs_read_text(store.root + "/state/rate_salt")
        if is_ok(read) and len(unwrap(read)) >= 32:
            return unwrap(read)
    let fresh = crypto_random_bytes(32)
    if not is_ok(fresh):
        return "no-salt"
    let hex = hex_encode(unwrap(fresh))
    let saved = vfs_write_text(store.root + "/state/rate_salt", hex)
    return hex

fn bucket_path(store: Store, key: Text) -> Text:
    let digest = crypto_sha256(bytes_from_text(rate_salt(store) + "|" + key))
    return "state/rate/" + text_slice(hex_encode(digest), 0, 32) + ".json"

# Records one request from `key` at `now`; false when it is over the limit. The window lives in a
# file per client, written atomically; two requests in the same instant can both read the old
# window, so the limit is a ceiling that may be exceeded by the number of simultaneous workers.
pub fn rate_hit(store: Store, key: Text, now: Int, limit: Int) -> Bool:
    let made = vfs_make_dir(store.root + "/state/rate")
    var stamps: List[Int] = []
    if store_has(store, bucket_path(store, key)):
        let read = store_get_json(store, bucket_path(store, key))
        if is_ok(read):
            for i in range(0, json_len(unwrap(read))):
                let n = json_int_safe(unwrap(json_index_safe(unwrap(read), i)))
                if is_ok(n):
                    set stamps = list_push(stamps, unwrap(n))
    let result = rate_check(stamps, now, limit)
    var out = json_array()
    for s in result.kept:
        set out = json_push(out, json_int(s))
    let saved = store_put_json(store, bucket_path(store, key), out)
    return result.allowed

# Deletes bucket files whose newest request is older than the window: a client's file lives for at
# most a minute after its last request, so no address-derived name is kept.
pub fn rate_sweep(store: Store, now: Int) -> Int:
    let listed = vfs_list(store.root + "/state/rate")
    var removed = 0
    if not is_ok(listed):
        return 0
    for name in unwrap(listed):
        let path = store.root + "/state/rate/" + name
        let read = vfs_read_text(path)
        var newest = 0
        if is_ok(read):
            let parsed = json_parse(unwrap(read))
            if is_ok(parsed):
                for i in range(0, json_len(unwrap(parsed))):
                    let n = json_int_safe(unwrap(json_index_safe(unwrap(parsed), i)))
                    if is_ok(n) and unwrap(n) > newest:
                        set newest = unwrap(n)
        if newest <= now - rate_window_seconds():
            if vfs_remove(path):
                set removed = removed + 1
    return removed
