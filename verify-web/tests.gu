import "std:types"
import "std:json"
import "std:text"
import "std:fs"
import "verify.gu"

fn main() -> Int:
    return 0

fn receipt(name: Text) -> Text:
    return unwrap(read_text("fixtures/" + name))

fn key(name: Text) -> Text:
    return text_trim(unwrap(read_text("fixtures/" + name)))

fn answer(receipt_text: Text, operator_key: Text) -> Json:
    return unwrap(json_parse(verify_page(receipt_text, operator_key)))

fn verdict_of(j: Json) -> Text:
    return json_as_text(json_get(j, "verdict"))

fn test_a_drand_only_anchored_receipt_is_verified() -> Unit:
    let a = answer(receipt("anchored-receipt.json"), key("anchored-operator-key.hex"))
    assert(verdict_of(a) == "verified")
    assert(json_as_int(json_get(a, "failed_step")) == 0)
    assert(json_len(json_get(a, "not_checked")) == 0)

fn test_a_receipt_with_an_idle_source_is_pending_live_and_says_it_is_not_fully_checked() -> Unit:
    let a = answer(receipt("anchored-receipt-all-sources.json"), key("anchored-operator-key.hex"))
    assert(verdict_of(a) == "verified-pending-live")
    assert(text_find(json_as_text(json_get(a, "detail")), "live", 0) >= 0)
    assert(text_find(json_as_text(json_get(a, "detail")), "curby-q", 0) >= 0)

fn test_a_changed_outcome_is_invalid_at_step_5() -> Unit:
    let original = receipt("anchored-receipt.json")
    let changed = text_replace(original, "\"hexagram\":", "\"hexagram\":9")
    assert(changed != original)
    let a = answer(changed, key("anchored-operator-key.hex"))
    assert(verdict_of(a) == "invalid")
    assert(json_as_int(json_get(a, "failed_step")) == 5)

fn test_the_wrong_operator_key_is_invalid_at_step_1() -> Unit:
    let a = answer(receipt("anchored-receipt.json"), "ff" + text_slice(key("anchored-operator-key.hex"), 2, 64))
    assert(verdict_of(a) == "invalid")
    assert(json_as_int(json_get(a, "failed_step")) == 1)

fn test_text_that_is_not_json_is_unreadable_not_a_crash() -> Unit:
    let a = answer("this is not a receipt", key("anchored-operator-key.hex"))
    assert(verdict_of(a) == "unreadable")
    assert(text_find(json_as_text(json_get(a, "detail")), "JSON", 0) >= 0)

fn test_json_that_is_not_an_object_is_unreadable() -> Unit:
    assert(verdict_of(answer("[1,2,3]", key("anchored-operator-key.hex"))) == "unreadable")

fn test_a_bad_operator_key_is_unreadable_and_says_so() -> Unit:
    let a = answer(receipt("anchored-receipt.json"), "not hex")
    assert(verdict_of(a) == "unreadable")
    assert(text_find(json_as_text(json_get(a, "detail")), "operator", 0) >= 0)

fn test_an_empty_receipt_is_unreadable() -> Unit:
    assert(verdict_of(answer("", key("anchored-operator-key.hex"))) == "unreadable")

fn test_an_invalid_answer_always_names_a_step_from_1_to_6() -> Unit:
    let a = answer("{}", key("anchored-operator-key.hex"))
    if verdict_of(a) == "invalid":
        let step = json_as_int(json_get(a, "failed_step"))
        assert(step >= 1 and step <= 6)
    else:
        assert(verdict_of(a) == "unreadable")

fn test_the_failure_sentence_names_the_step_and_what_it_checks() -> Unit:
    let s = failure_sentence(5, "the outcome differs")
    assert(text_find(s, "step 5", 0) >= 0)
    assert(text_find(s, "the outcome", 0) >= 0)

fn test_a_step_outside_1_to_6_is_not_named_as_a_step() -> Unit:
    let s = failure_sentence(0, "something odd")
    assert(text_find(s, "step", 0) < 0)
    assert(text_find(s, "something odd", 0) >= 0)

# ---------------------------------------------------------------- the draw entry points

fn repeat(piece: Text, n: Int) -> Text:
    var out = ""
    for i in range(0, n):
        set out = out + piece
    return out

fn nonce_hex() -> Text:
    return "000102030405060708090a0b0c0d0e0f"

fn salt_hex() -> Text:
    return repeat("11", 32)

fn plan_of(question: Text) -> Json:
    return unwrap(json_parse(draw_plan("tarot", "rws", "{\"count\":\"3\",\"reversals\":\"true\"}", question, nonce_hex(), salt_hex())))

fn test_draw_plan_seals_the_question_and_never_sends_it() -> Unit:
    let p = plan_of("Will it rain?")
    let body = json_as_text(json_get(p, "body"))
    assert(text_find(body, "\"commitment\"", 0) >= 0)
    assert(text_find(body, "Will it rain?", 0) < 0)
    assert(len(json_as_text(json_get(p, "entry_hash"))) == 128)
    assert(json_as_bool(json_get(p, "asked")))

# Made once with the command line: plan_draw(["tarot","rws","count=3","reversals=true","--question","Will it rain?"],
# nonce 00..0f, salt 32 bytes of 0x11).entry_hash_hex
fn cli_entry_hash() -> Text:
    return "305763565102c08a7051219fc466bd759553ebaa0c5b3dd96fe43d82f2e8807bd0c21bb1e930c5b616c50af2aba0a0480d6d567c39463bce06a9f329e82be311"

fn test_draw_plan_matches_the_cli() -> Unit:
    assert(json_as_text(json_get(plan_of("Will it rain?"), "entry_hash")) == cli_entry_hash())

fn test_a_blank_question_is_no_question() -> Unit:
    let p = plan_of("   ")
    assert(not json_as_bool(json_get(p, "asked")))
    assert(text_find(json_as_text(json_get(p, "body")), "commitment", 0) < 0)

fn test_a_long_emoji_question_is_sealed() -> Unit:
    let p = plan_of(repeat("🌙", 5000))
    assert(json_as_bool(json_get(p, "asked")))
    assert(not is_ok(json_get_safe(p, "error")))

fn test_a_malformed_options_object_is_an_error_sentence() -> Unit:
    let p = unwrap(json_parse(draw_plan("tarot", "rws", "[1]", "", nonce_hex(), salt_hex())))
    assert(is_ok(json_get_safe(p, "error")))

fn view_text() -> Text:
    return receipt("view-complete.json")

fn view_request() -> Text:
    return json_stringify(json_get(json_get(unwrap(json_parse(view_text())), "receipt"), "request"))

fn view_hash() -> Text:
    return json_as_text(json_get(unwrap(json_parse(view_text())), "entry_hash"))

fn test_check_view_accepts_the_fixture() -> Unit:
    assert(check_view(view_text(), key("anchored-operator-key.hex"), view_request(), view_hash()) == "")

fn test_check_view_rejects_a_changed_entry_hash() -> Unit:
    let changed = text_replace(view_text(), "\"entry_hash\":\"" + text_slice(view_hash(), 0, 1), "\"entry_hash\":\"" + "0")
    assert(changed != view_text())
    assert(check_view(changed, key("anchored-operator-key.hex"), view_request(), view_hash()) != "")

fn test_verify_draw_checks_the_question() -> Unit:
    let r = receipt("anchored-receipt.json")
    let a = unwrap(json_parse(verify_draw(r, key("anchored-operator-key.hex"), "Will it rain?", salt_hex())))
    assert(verdict_of(a) == "invalid")
    assert(json_as_int(json_get(a, "failed_step")) == 6)
    let b = unwrap(json_parse(verify_draw(r, key("anchored-operator-key.hex"), "  ", salt_hex())))
    assert(verdict_of(b) == "verified")
